    "node": ">=22"
  },
  "scripts": {
    "spend": "node src/spend-report.mjs",
    "index:candidates": "node src/indexer/candidates.mjs",
    "index:run": "node src/indexer/run.mjs",
    "index:stats": "node src/indexer/stats.mjs",
    "web": "node src/web/server.mjs",
    "eval": "node eval/run.mjs",
    "index:topup": "node src/indexer/topup.mjs",
    "index:export": "node src/indexer/export-bundle.mjs",
